# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# MongoDB Atlas connection string
# Get from: https://cloud.mongodb.com > Connect > Drivers
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/mostafa_school?retryWrites=true&w=majority

# JWT Secret — use a long random string (min 32 chars)
JWT_SECRET=change_this_to_a_very_long_random_secret_key_minimum_32_chars

# JWT expiry
JWT_EXPIRES_IN=7d

# Server port (Render will set PORT automatically)
PORT=5000

# Frontend URL (for CORS) — your Vercel/Netlify URL
CLIENT_URL=https://your-school-site.vercel.app

# Email (for guardian absence notifications)
# Use Gmail App Password: https://myaccount.google.com/apppasswords
EMAIL_USER=yourschool@gmail.com
EMAIL_PASS=your_gmail_app_password

# Node environment
NODE_ENV=production
